{
  "name": "market-prediction-lab",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "check": "node scripts/check-all.js",
    "test": "node --test tests/*.test.js",
    "test:temporal": "node --test tests/derivatives-history.test.js tests/derivatives-normalized-compat.test.js tests/temporal-training-dataset.test.js tests/market-structure-history.test.js tests/model-ensemble.test.js tests/shadow-ledger.test.js",
    "smoke": "node scripts/smoke-pipeline.js",
    "stress": "node scripts/stress-pipeline.js",
    "fuzz": "node scripts/fuzz-pipeline.js",
    "validate": "npm run check && npm test && npm run smoke && npm run stress && npm run fuzz",
    "collect:bitget": "node scripts/collect-bitget.js",
    "research:stocks": "node scripts/run-stock-market-suite.js",
    "research:stocks:pnl": "node scripts/run-stock-pnl-suite.js",
    "research:stocks:generalization": "node scripts/run-stock-generalization-suite.js",
    "research:spot:upbit": "node scripts/run-upbit-spot-suite.js",
    "research:spot:upbit:pnl": "node scripts/run-upbit-spot-pnl-suite.js",
    "research:funding": "node scripts/run-derivatives-suite.js",
    "research:structure": "node scripts/run-market-structure-suite.js",
    "backtest:v1": "node scripts/run-v1-backtest.js",
    "backtest:v1:history": "node scripts/run-long-history-v1.js",
    "backtest:v3:history": "node scripts/run-v3-history.js",
    "backtest:v4:history": "node scripts/run-v4-history.js",
    "backtest:v5:history": "node scripts/run-v5-history.js",
    "backtest:v6:history": "node scripts/run-v6-history.js",
    "shadow:cycle": "node scripts/run-shadow-cycle.js"
  }
}
