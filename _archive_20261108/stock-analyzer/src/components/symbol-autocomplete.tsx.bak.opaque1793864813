import { useEffect, useMemo, useRef, useState } from 'react';

export type SymbolItem = {
  symbol: string;
  name: string;
  market: string;
  tradable: boolean;
  autoTradable: boolean;
  manualTradable: boolean;
};

export function SymbolAutocomplete({
  value,
  market,
  onChange,
  placeholder = '종목 검색',
  className,
}: {
  value: string;
  market: string;
  onChange: (symbol: string) => void;
  placeholder?: string;
  className?: string;
}) {
  const [query, setQuery] = useState('');
  const [results, setResults] = useState<SymbolItem[]>([]);
  const [open, setOpen] = useState(false);
  const [active, setActive] = useState(0);
  const [loading, setLoading] = useState(false);
  const boxRef = useRef<HTMLDivElement>(null);

  const display = useMemo(() => {
    if (!value) return '';
    const m = results.find(r => r.symbol === value);
    return m ? `${m.name} (${m.symbol})` : value;
  }, [value, results]);

  useEffect(() => {
    const onDocClick = (e: MouseEvent) => {
      if (boxRef.current && !boxRef.current.contains(e.target as Node)) {
        setOpen(false);
      }
    };
    document.addEventListener('mousedown', onDocClick);
    return () => document.removeEventListener('mousedown', onDocClick);
  }, []);

  useEffect(() => {
    if (!open) return;
    const q = query.trim();
    if (q.length < 1) { setResults([]); return; }
    setLoading(true);
    const t = setTimeout(async () => {
      try {
        const url = `/symbols/search?q=${encodeURIComponent(q)}&market=${encodeURIComponent(market)}&source=all`;
        const r = await fetch(url);
        const d = await r.json();
        setResults(d.items || []);
        setActive(0);
      } catch {
        setResults([]);
      } finally {
        setLoading(false);
      }
    }, 200);
    return () => clearTimeout(t);
  }, [query, market, open]);

  const selectItem = (it: SymbolItem) => {
    onChange(it.symbol);
    setQuery(`${it.name} (${it.symbol})`);
    setOpen(false);
  };

  return (
    <div ref={boxRef} className="relative">
      <input
        type="text"
        value={open ? query : display}
        onChange={(e) => { setQuery(e.target.value); setOpen(true); }}
        onFocus={() => { setQuery(''); setOpen(true); }}
        onKeyDown={(e) => {
          if (!open) return;
          if (e.key === 'ArrowDown') { e.preventDefault(); setActive(a => Math.min(a + 1, results.length - 1)); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(a => Math.max(a - 1, 0)); }
          else if (e.key === 'Enter') { e.preventDefault(); if (results[active]) selectItem(results[active]); }
          else if (e.key === 'Escape') setOpen(false);
        }}
        placeholder={placeholder}
        className={className || 'w-full border border-card-border rounded bg-background px-2 py-1.5 text-sm text-foreground'}
        autoComplete="off"
      />
      {open && (
        <div className="absolute z-50 mt-1 w-full max-h-72 overflow-auto rounded border border-card-border bg-background shadow-lg">
          {loading && <div className="px-2 py-1.5 text-xs text-muted-foreground">검색 중...</div>}
          {!loading && query.trim().length === 0 && (
            <div className="px-2 py-1.5 text-xs text-muted-foreground">종목명 또는 코드 입력</div>
          )}
          {!loading && query.trim().length > 0 && results.length === 0 && (
            <div className="px-2 py-1.5 text-xs text-muted-foreground">결과 없음</div>
          )}
          {results.map((it, i) => (
            <div
              key={`${it.market}:${it.symbol}`}
              onMouseDown={(e) => { e.preventDefault(); selectItem(it); }}
              onMouseEnter={() => setActive(i)}
              className={`px-2 py-1.5 text-sm cursor-pointer ${i === active ? 'bg-accent/40' : 'hover:bg-accent/20'}`}
            >
              <span className="font-medium">{it.name}</span>
              <span className="ml-2 text-xs text-muted-foreground">{it.symbol} · {it.market}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
