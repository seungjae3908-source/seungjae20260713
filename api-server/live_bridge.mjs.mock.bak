import fs from 'fs';

console.log(`🛡️ Live Bridge v3.0 시작 (FUTURES 3x Leverage)`);
console.log(`    DRY_RUN: false`);
console.log(`    레버리지: 3x | 하드 스탑로스: 1.5%`);

// 앱 대시보드 스위치 및 주문 송출 루프
async function runBridgeTick() {
    try {
        // 앱 스위치 상태 확인 (예시 설정 또는 연동 파일 기준)
        // 사용자가 앱에서 automaticEnabled를 켜고 끄는 상태를 감지
        const appConfig = globalThis.appConfig || { automaticEnabled: true }; 
        
        if (!appConfig.automaticEnabled) {
            console.log(`⏸️ [LIVE] 앱에서 정지 상태입니다 (automaticEnabled: false). 매매를 대기합니다.`);
            return;
        }

        console.log(`════════ LIVE BRIDGE TICK (3x Leverage Active) ════════`);
        console.log(`✅ [주문 브리지 정상 작동 중] 3배 레버리지 숏 시그널 비트겟 전송 대기 완료.`);
    } catch (err) {
        console.error('[BRIDGE TICK ERROR]:', err.message);
    }
}

// 1분 주기 브리지 틱 실행
setInterval(runBridgeTick, 60000);
runBridgeTick();
