# 2026-11-17 11:11:11.300381
+cd ~/seungjae20260713/api-server
+
+# 1. 기존 litellm 종료 후 정확한 Groq 모델명으로 config.yaml 덮어쓰기 (2중 폴백)
+pkill -f "litellm --config" || true
+
+cat << 'EOF' > config.yaml
+model_list:
+  - model_name: coding-agent
+    litellm_params:
+      model: groq/qwen/qwen3.8-27b
+      api_key: os.environ/GROQ_API_KEY
+      rpm: 20
+
+  - model_name: fallback-gpt-oss
+    litellm_params:
+      model: groq/openai/gpt-oss-120b
+      api_key: os.environ/GROQ_API_KEY
+      rpm: 20
+
+router_settings:
+  routing_strategy: simple-shuffle
+  num_retries: 2
+  fallbacks:
+    - coding-agent:
+        - fallback-gpt-oss
+
+litellm_settings:
+  drop_params: true
+
+general_settings:
+  master_key: os.environ/LITELLM_MASTER_KEY
+EOF
+
+# 2. LiteLLM 재실행
+nohup ~/litellm-venv/bin/litellm --config config.yaml --port 4000 > litellm.log 2>&1 &
+sleep 5 && tail -n 5 litellm.log
+
+# 3. 현재 폴더(api-server)만 빠르게 읽도록 Aider 실행
+~/aider-venv/bin/aider --model openai/coding-agent --subtree-only --no-show-model-warnings
+

# 2026-11-17 11:31:04.570475
+# 1. Aider 종료 후 터미널에서 4000번 포트 점유 프로세스 확실히 종료
+fuser -k 4000/tcp 2>/dev/null || pkill -9 -f litellm || true
+sleep 2
+
+# 2. LiteLLM 재실행 및 로그 확인
+nohup ~/litellm-venv/bin/litellm --config ~/seungjae20260713/api-server/config.yaml --port 4000 > litellm.log 2>&1 &
+sleep 5 && tail -n 10 litellm.log
+
+# 3. Aider 실행
+~/aider-venv/bin/aider --model openai/coding-agent --subtree-only --no-show-model-warnings
+

