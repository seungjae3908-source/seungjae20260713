# AI 복구센터 활성화
AI_REPAIR_ENABLED=true

# GitHub와 연결된 실제 소스 저장소. 운영 빌드 폴더가 아니라 .git이 있는 작업 저장소를 지정합니다.
AI_REPAIR_REPO_PATH=/root/stock-app-staging/work-backup-20260721/seungjae20260713
AI_REPAIR_BASE_BRANCH=v8-ai-live
AI_REPAIR_GIT_FETCH=true
AI_REPAIR_PUSH_BRANCH=true

# 작업 대기열과 격리 작업공간
AI_REPAIR_DATA_DIR=/var/lib/seungjae-ai-repair
AI_REPAIR_MAX_ATTEMPTS=5

# root 소유, mode 700으로 설치한 고정 배포 스크립트
AI_REPAIR_DEPLOY_SCRIPT=/usr/local/sbin/seungjae-ai-approved-deploy
AI_REPAIR_TARGET_PATH=/opt/stock-app
AI_REPAIR_BACKUP_ROOT=/var/backups/seungjae-ai-repair
AI_REPAIR_PM2_APP=stock-app
AI_REPAIR_HEALTH_URL=https://lsj119.duckdns.org/api/health
AI_REPAIR_PNPM_BIN=pnpm
AI_REPAIR_CHROMIUM_BIN=/snap/bin/chromium

# 실제 값은 이 파일에 적지 말고 서버의 비밀 환경변수에 등록합니다.
OPENAI_API_KEY=
OPENAI_REPAIR_MODEL=gpt-5.1

# 기존 웹 푸시 설정도 필요합니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
