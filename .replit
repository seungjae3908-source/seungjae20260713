modules = ["nodejs-24"]

run = [
  "bash",
  "-lc",
  "if [ ! -d node_modules ]; then pnpm install --no-frozen-lockfile; fi; pnpm --filter @workspace/stock-analyzer run build && pnpm --filter @workspace/api-server run build:server && exec env PORT=8080 NODE_ENV=development node --enable-source-maps api-server/dist/index.mjs"
]

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 80

[userenv]

[userenv.shared]
KIWOOM_BASE_URL = "https://lsj119.duckdns.org/kiwoom"
SUPABASE_ANON_KEY = "sb_publishable_l5iOTxTerk7gv3eDYouXcg_Q-YmVsZU"
SUPABASE_URL = "https://bawcbkoyovbeajkrnduq.supabase.co"
VITE_SUPABASE_ANON_KEY = "sb_publishable_l5iOTxTerk7gv3eDYouXcg_Q-YmVsZU"
KIWOOM_MODE = "real"

[workflows]

[[workflows.workflow]]
name = "패키지 설치"
mode = "sequential"
author = 61907377

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install --no-frozen-lockfile"

[[workflows.workflow]]
name = "프런트 빌드"
mode = "sequential"
author = 61907377

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/stock-analyzer run build"

[[workflows.workflow]]
name = "앱 전체 실행"
mode = "sequential"
author = 61907377

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "stock-app"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "if [ ! -d node_modules ]; then pnpm install --no-frozen-lockfile; fi; pnpm --filter @workspace/stock-analyzer run build && pnpm --filter @workspace/api-server run build:server && exec env PORT=8080 NODE_ENV=development node --enable-source-maps api-server/dist/index.mjs"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[agent]
expertMode = true

[deployment]
deploymentTarget = "cloudrun"
