[Unit]
Description=Investment Research Lab read-only dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=investment-research
Group=investment-research
WorkingDirectory=/opt/investment-research-dashboard/current/research-dashboard
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=RESEARCH_DASHBOARD_HOST=127.0.0.1
Environment=RESEARCH_DASHBOARD_PORT=18090
Environment=RESEARCH_STATE_ROOT=/var/lib/investment-research-production
# The host policy denies executable-memory remapping, so keep V8 JIT disabled.
# Node 22 initializes the global fetch/undici stack by default; under --jitless
# that path requires WebAssembly and exits before this dashboard binds. This
# server never uses fetch, so disable the unused global fetch bootstrap rather
# than weakening the systemd sandbox or enabling executable memory.
ExecStart=/usr/bin/env node --jitless --no-experimental-fetch /opt/investment-research-dashboard/current/research-dashboard/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
# Keep the long-running Node service aligned with the already-proven Research
# Production sandbox. ProtectSystem=strict keeps the release and research state
# read-only; only the private /tmp namespace is explicitly writable.
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
