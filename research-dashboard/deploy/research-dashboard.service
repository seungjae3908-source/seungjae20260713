[Unit]
Description=Investment Research Lab read-only dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=investment-research
Group=investment-research
WorkingDirectory=/opt/investment-research-dashboard/current/research-dashboard
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=RESEARCH_DASHBOARD_HOST=127.0.0.1
Environment=RESEARCH_DASHBOARD_PORT=18090
Environment=RESEARCH_STATE_ROOT=/var/lib/investment-research-production
ExecStart=/usr/bin/env node /opt/investment-research-dashboard/current/research-dashboard/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Node/V8 JIT requires executable memory. Research Production intentionally
# leaves MemoryDenyWriteExecute disabled for the same runtime reason.
ReadOnlyPaths=/opt/investment-research-dashboard/current /var/lib/investment-research-production
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
