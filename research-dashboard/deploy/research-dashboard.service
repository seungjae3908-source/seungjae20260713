[Unit]
Description=Investment Research Lab read-only dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=investment-research
Group=investment-research
WorkingDirectory=/opt/investment-research-dashboard/current/research-dashboard
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=RESEARCH_DASHBOARD_HOST=127.0.0.1
Environment=RESEARCH_DASHBOARD_PORT=18090
Environment=RESEARCH_STATE_ROOT=/var/lib/investment-research-production
# This long-running HTTP process reaches V8 baseline JIT under normal Node startup.
# The shared server policy denies executable-memory remapping, so keep JIT disabled.
# Node 22's global Fetch/WebSocket surface lazily loads Undici, whose llhttp path
# requires WebAssembly; --jitless disables WebAssembly. The dashboard uses neither
# Fetch nor WebSocket, so disable those unused globals instead of weakening sandboxing.
ExecStart=/usr/bin/env node --jitless --no-experimental-fetch --no-experimental-websocket /opt/investment-research-dashboard/current/research-dashboard/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
# Keep the long-running Node service aligned with the already-proven Research
# Production sandbox. ProtectSystem=strict keeps the release and research state
# read-only; only the private /tmp namespace is explicitly writable.
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
