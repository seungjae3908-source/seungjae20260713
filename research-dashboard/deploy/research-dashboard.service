[Unit]
Description=Investment Research Lab read-only dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=investment-research
Group=investment-research
WorkingDirectory=/opt/investment-research-dashboard/current/research-dashboard
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=RESEARCH_DASHBOARD_HOST=127.0.0.1
Environment=RESEARCH_DASHBOARD_PORT=18090
Environment=RESEARCH_STATE_ROOT=/var/lib/investment-research-production
# Use the Python standard-library HTTP runtime so this long-running read-only
# dashboard does not require V8 JIT, executable-memory remapping, WebAssembly,
# Undici, or third-party packages on the production host.
ExecStart=/usr/bin/env python3 /opt/investment-research-dashboard/current/research-dashboard/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
# Research state and release remain read-only under ProtectSystem=strict.
# Only the private /tmp namespace is explicitly writable.
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
