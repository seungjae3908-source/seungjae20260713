[Unit]
Description=Stock App public Forward server-canonical natural evidence capture
Documentation=https://github.com/seungjae3908-source/seungjae20260713
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
ConditionPathExists=/opt/stock-app-server-evidence-canonical-v1/current/.deploy/current-sha
ConditionPathExists=/opt/stock-app-server-evidence-canonical-v1/activation.json

[Service]
Type=oneshot
DynamicUser=true
WorkingDirectory=/opt/stock-app-server-evidence-canonical-v1/current
Environment=SERVER_EVIDENCE_SHADOW_ONLY=false
Environment=SERVER_EVIDENCE_SERVER_CANONICAL=true
Environment=SERVER_EVIDENCE_REPOSITORY=seungjae3908-source/seungjae20260713
Environment=SERVER_EVIDENCE_STATE_ROOT=/var/lib/stock-app-server-evidence-canonical-v1
Environment=SERVER_EVIDENCE_CANONICAL_ACTIVATION_PATH=/opt/stock-app-server-evidence-canonical-v1/activation.json
Environment=SERVER_EVIDENCE_DEPLOY_SHA_FILE=/opt/stock-app-server-evidence-canonical-v1/current/.deploy/current-sha
ExecStart=/usr/bin/env node market-intelligence-sidecar/scripts/run-public-forward-liquidity-server-canonical-runtime-v1.mjs tick
StateDirectory=stock-app-server-evidence-canonical-v1
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/stock-app-server-evidence-canonical-v1/current
ReadOnlyPaths=/opt/stock-app-server-evidence-canonical-v1/activation.json
ReadWritePaths=/var/lib/stock-app-server-evidence-canonical-v1
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=5m

# Safety boundary:
# - public market data + public GitHub metadata only
# - protected activation record required
# - SERVER_CANONICAL=true only in this isolated evidence service
# - canonical economic credit remains 0 until separate protected ingest
# - no private trading API, order, cancel, amend, transfer, withdrawal or Replit authority
