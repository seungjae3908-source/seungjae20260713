[Unit]
Description=Stock App public Forward server canonical natural capture
Documentation=https://github.com/seungjae3908-source/seungjae20260713
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
ConditionPathExists=/opt/stock-app-server-evidence-shadow-v1/current/.deploy/current-sha
ConditionPathExists=/opt/stock-app-server-evidence-shadow-v1/canonical-activation-v1/cutover-readiness.json
ConditionPathExists=/opt/stock-app-server-evidence-shadow-v1/canonical-activation-v1/runtime-activation.json

[Service]
Type=oneshot
DynamicUser=true
WorkingDirectory=/opt/stock-app-server-evidence-shadow-v1/current
Environment=SERVER_EVIDENCE_SHADOW_ONLY=false
Environment=SERVER_EVIDENCE_SERVER_CANONICAL=true
Environment=SERVER_EVIDENCE_STATE_ROOT=/var/lib/stock-app-server-evidence-shadow-v1
Environment=SERVER_EVIDENCE_DEPLOY_SHA_FILE=/opt/stock-app-server-evidence-shadow-v1/current/.deploy/current-sha
Environment=SERVER_CANONICAL_READINESS_PATH=/opt/stock-app-server-evidence-shadow-v1/canonical-activation-v1/cutover-readiness.json
Environment=SERVER_CANONICAL_RUNTIME_ACTIVATION_PATH=/opt/stock-app-server-evidence-shadow-v1/canonical-activation-v1/runtime-activation.json
Environment=SERVER_CANONICAL_REPOSITORY=seungjae3908-source/seungjae20260713
EnvironmentFile=-/etc/stock-app/server-evidence-shadow-v1.env
ExecStart=/usr/bin/env node market-intelligence-sidecar/scripts/run-public-forward-liquidity-server-canonical-runtime-v1.mjs tick
StateDirectory=stock-app-server-evidence-shadow-v1
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/stock-app-server-evidence-shadow-v1/current
ReadOnlyPaths=/opt/stock-app-server-evidence-shadow-v1/canonical-activation-v1
ReadWritePaths=/var/lib/stock-app-server-evidence-shadow-v1
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=5m

# Safety boundary:
# - separate protected activation record required; default runtime remains OFF in source
# - Production application /opt/stock-app is never modified
# - public market data and public GitHub metadata only
# - GitHub V3 schedule has source precedence and recovery stops server canonical capture
# - no replay/backfill/manual/synthetic/hindsight credit
# - canonical capture package is create-only and still zero economic credit until protected ingest
# - no private trading API, order, cancel, amend, transfer, withdrawal or Replit authority
