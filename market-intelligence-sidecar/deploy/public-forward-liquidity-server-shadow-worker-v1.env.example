# Server Evidence Shadow Worker V1 runtime identity.
# Populate only after the deployed SHA and Release Control receipt are verified.
# Never place provider API secrets in this file.

SERVER_EVIDENCE_ACTIVATION_RECEIPT_COMMENT_ID=
SERVER_EVIDENCE_ACTIVATION_RECEIPT_MAIN_SHA=
SERVER_EVIDENCE_EXPECTED_BINDING_DIGEST=

# The systemd unit hard-codes these safety flags and V1 rejects canonical mode in code:
# SERVER_EVIDENCE_SHADOW_ONLY=true
# SERVER_EVIDENCE_SERVER_CANONICAL=false
