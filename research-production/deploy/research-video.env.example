# Read-only YouTube public discovery for Research Production.
# This file is inert until the separate systemd timer is explicitly installed/enabled.
RESEARCH_VIDEO_DISCOVERY_APPROVED=false
# YOUTUBE_DATA_API_KEY is loaded only from /etc/investment-research/research-providers.env.

# Optional bounded rotation. Maximum 8 unique queries, max 120 chars each.
RESEARCH_VIDEO_DISCOVERY_QUERIES_JSON=["국내 주식 단타 거래량 돌파 전략","미국 주식 데이트레이딩 RVOL ORB 전략","코인 현물 CVD 오더플로우 VWAP 전략","코인 선물 OI CVD 테이커 플로우 전략","korea stock momentum volume breakout strategy","US stocks in play RVOL ORB retest strategy","crypto spot order flow CVD VWAP reclaim strategy","crypto futures open interest CVD trend strategy"]

# YouTube public search result count per run. Allowed 1..3.
RESEARCH_VIDEO_DISCOVERY_MAX_RESULTS=3

# Optional locale hints. Leave empty for provider defaults.
RESEARCH_VIDEO_DISCOVERY_REGION_CODE=
RESEARCH_VIDEO_DISCOVERY_RELEVANCE_LANGUAGE=

# Freshness window for latest-first discovery. Allowed 1..2160 hours; default 720 (30 days).
RESEARCH_VIDEO_DISCOVERY_PUBLISHED_AFTER_HOURS=720
