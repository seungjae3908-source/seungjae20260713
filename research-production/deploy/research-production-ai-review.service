[Unit]
Description=Investment Research Production autonomous V2 and compatible AI review scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=investment-research
Group=investment-research
WorkingDirectory=/opt/investment-research/current
EnvironmentFile=/etc/investment-research/research-production.env
EnvironmentFile=-/etc/investment-research/research-ai.env
EnvironmentFile=-/etc/investment-research/research-providers.env
Environment=RESEARCH_AI_INVOCATION_MODE=SYSTEMD_TIMER
# Contract marker only; Dashboard systemd timer correlation supplies actual timer proof.
ExecStart=/usr/bin/env node research-production/bin/autonomous-research-coordinator-v2.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/investment-research-production
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
Nice=10
CPUQuota=80%
MemoryMax=2G
TasksMax=64
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=8m

[Install]
WantedBy=multi-user.target
