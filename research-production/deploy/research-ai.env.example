# Research Production FREE-AI review worker.
# Keep disabled until the configured provider account/quota is explicitly confirmed as free-only.
RESEARCH_AI_FREE_TIER_CONFIRMED=false

# Allowed values for the Research Production worker: groq or gemini.
AI_CHAT_PROVIDER=groq

# The model (GROQ_MODEL=openai/gpt-oss-20b, the only allowlisted free model) and
# the credentials live in /etc/investment-research/research-providers.env, written
# by research-provider-bootstrap. This policy file accepts only
# RESEARCH_AI_FREE_TIER_CONFIRMED, AI_CHAT_PROVIDER and RESEARCH_AI_MAX_CALLS_PER_SCAN;
# the isolated release validation rejects any other key here
# (ISOLATED_TRANSITION_ENV_KEY_FORBIDDEN).

# Alternative selected provider configuration. Groq/Gemini credentials may coexist; AI_CHAT_PROVIDER decides which isolated route this worker uses.
# AI_CHAT_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_API_KEY is supplied by research-providers.env, not this policy file.

# Maximum new evidence digests reviewed in one hourly scan.
RESEARCH_AI_MAX_CALLS_PER_SCAN=3
