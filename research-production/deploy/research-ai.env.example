# Research Production FREE-AI review worker.
# Keep disabled until the configured provider account/quota is explicitly confirmed as free-only.
RESEARCH_AI_FREE_TIER_CONFIRMED=false

# Allowed values for the Research Production worker: groq or gemini.
AI_CHAT_PROVIDER=groq

# Exact allowlisted free-only model. Do not substitute paid models.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Alternative isolated provider configuration:
# AI_CHAT_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_API_KEY=

# Maximum new evidence digests reviewed in one hourly scan.
RESEARCH_AI_MAX_CALLS_PER_SCAN=3
