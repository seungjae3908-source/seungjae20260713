[Unit]
Description=Isolated four-market 1m public history backfill (research only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=oneshot
User=investment-research
Group=investment-research
WorkingDirectory=/opt/investment-research/current
EnvironmentFile=/etc/investment-research/research-production.env
ExecStart=/usr/bin/env node --max-old-space-size=160 research-production/bin/four-market-minute-backfill.mjs --execute
CPUAccounting=true
CPUQuota=25%
MemoryAccounting=true
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=64M
TasksMax=24
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/investment-research-production
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
TimeoutStartSec=240s
