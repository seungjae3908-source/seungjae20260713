[Unit]
Description=Investment Research Autonomous AI (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=investment-research
Group=investment-research
WorkingDirectory=/opt/investment-research/current
EnvironmentFile=/etc/investment-research/research-production.env
EnvironmentFile=-/etc/investment-research/research-ai.env
ExecStart=/usr/bin/env node research-production/bin/autonomous-research-ai.mjs %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/investment-research-production
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=15m

# Deliberately no [Install] section and no timer in this slice.
# The service cannot become recurring until a separate explicit activation approval.
