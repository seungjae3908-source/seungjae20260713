RESEARCH_REPO_ROOT=/opt/investment-research/current
RESEARCH_STATE_ROOT=/var/lib/investment-research-production
RESEARCH_CODE_SHA=REPLACE_WITH_EXACT_40_CHAR_SHA
RESEARCH_CONCURRENCY=4
RESEARCH_MIN_FREE_BYTES=5368709120
LIVE_TRADING=false
LIVE_TRADING_ENABLED=false
REAL_ORDER_ENABLED=false
REAL_TRADING_ENABLED=false
PRIVATE_API_ENABLED=false
PRIVATE_ACCOUNT_ACCESS=false
PRIVATE_TRADING_API_ALLOWED=false
ORDER_AUTHORITY=false
ORDER_SUBMISSION_ENABLED=false
RESEARCH_TEMPORAL_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
RESEARCH_TEMPORAL_LONG_SHORT_PERIOD=1h
RESEARCH_ADAPTIVE_POLICY_RECORD_PATH=
RESEARCH_DATA_FACTORY_EVIDENCE_PATH=
RESEARCH_ADAPTIVE_EVIDENCE_CATALOG_PATH=
RESEARCH_ADAPTIVE_DEVELOPMENT_DIAGNOSTICS_PATH=
RESEARCH_ADAPTIVE_RUNTIME_BINDINGS_PATH=
# Research coordinator stages (10-minute ai-review timer). Each is ON unless set
# to exactly "false"; an unset value does NOT disable it. Watchdog and grid-DCA
# research have no switch. None of these can place an order.
RESEARCH_UNIVERSE_V2_ENABLED=true
RESEARCH_EXPLORATORY_PAPER_ENABLED=true
RESEARCH_PAPER_DISCOVERY_ENABLED=true
RESEARCH_RESULTS_DIGEST_ENABLED=true
